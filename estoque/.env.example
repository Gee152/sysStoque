# Server
PORT=3333
NODE_ENV=development

# Database (PostgreSQL local via Docker ou Supabase)
# Local (docker-compose): postgresql://user:password@localhost:5432/estoque
DATABASE_URL="postgresql://user:password@localhost:5432/estoque"

# JWT Authentication
JWT_SECRET=stockflow-jwt-secret-dev
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Supabase Storage (Upload de imagens das variantes)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_STORAGE_BUCKET=products
